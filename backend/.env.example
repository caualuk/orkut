# Copie para `.env` e preencha. NUNCA versione o arquivo `.env`.
NODE_ENV=development
PORT=3000

# Origens autorizadas (CORS + verificação de Origin), separadas por vírgula
CORS_ORIGINS=http://localhost:4200

# Número de proxies reversos confiáveis à frente da API (0 = nenhum)
TRUST_PROXY=0

# PostgreSQL (Supabase → Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:<SENHA>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_SSL=true
# CA raiz do Supabase usada para validar o certificado TLS do banco
DATABASE_SSL_CA_PATH=certs/supabase-root-2021.crt
# Na Vercel use backend/certs/supabase-root-2021.crt (ver docs/deploy.md).
# Alternativa: o conteúdo PEM da CA, com precedência sobre o _PATH.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Supabase (reservado para Storage/Auth admin em telas futuras — somente backend)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Sessões
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
